{
	"schemaVersion": 1,
	"id": "hud-studio",
	"version": "${version}",
	"name": "Ball's HUD Studio",
	"authors": ["ball534"],
    "description": "Client-side HUD editor, inventory displays, camera tweaks, combo meter, waypoints and a persistent explored world map.",
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.hudstudio.client.HudStudioClient"
		],
		"modmenu": [
			"dev.hudstudio.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "hud-studio.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"modmenu": ">=21.0.0"
	}
}
